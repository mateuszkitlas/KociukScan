{
  "name": "scan",
  "version": "0.1.0",
  "private": true,
  "homepage": "./",
  "description": "Scanning books",
  "license": "ISC",
  "author": "mateusz.kitlas@gmail.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mateuszkitlas/scan.git"
  },
  "dependencies": {
    "@types/adm-zip": "^0.4.34",
    "@types/md5": "^2.3.0",
    "@types/node": "^12.0.0",
    "@types/pdfkit": "^0.11.0",
    "@types/react": "^17.0.0",
    "@types/react-dom": "^17.0.0",
    "@types/sharp": "^0.28.0",
    "adm-zip": "^0.5.5",
    "electron-squirrel-startup": "^1.0.0",
    "md5": "^2.3.0",
    "pdfkit": "^0.12.1",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-icons": "^4.2.0",
    "scanner-to-buffer": "2.0.0",
    "sharp": "0.22.1",
    "typescript": "^4.1.2",
    "web-vitals": "^1.0.1"
  },
  "scripts": {
    "start": "electron-forge start",
    "start-react": "craco start",
    "build": "tsc && parcel build static/index.html --target electron --out-dir build --public-url ./",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "make-win": "electron-forge make --platform win32"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      "last 1 electron version"
    ],
    "development": [
      "last 1 electron version"
    ]
  },
  "devDependencies": {
    "@electron-forge/cli": "^6.0.0-beta.54",
    "@electron-forge/maker-deb": "^6.0.0-beta.54",
    "@electron-forge/maker-rpm": "^6.0.0-beta.54",
    "@electron-forge/maker-squirrel": "^6.0.0-beta.54",
    "@electron-forge/maker-zip": "^6.0.0-beta.54",
    "electron": "^6",
    "parcel-bundler": "^1.12.5"
  },
  "main": "main.js",
  "config": {
    "forge": {
      "packagerConfig": {},
      "makers": [
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {
            "name": "scan",
            "asar": "false"
          }
        },
        {
          "name": "@electron-forge/maker-zip",
          "platforms": [
            "darwin"
          ]
        },
        {
          "name": "@electron-forge/maker-deb",
          "config": {}
        },
        {
          "name": "@electron-forge/maker-rpm",
          "config": {}
        }
      ]
    }
  }
}
